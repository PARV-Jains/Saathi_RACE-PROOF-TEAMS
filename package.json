{
  "name": "saathi-race-proof-teams",
  "version": "1.0.0",
  "description": "Saathi - race-proof team formation",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "dev": "tsx watch src/server.ts",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "seed": "tsx scripts/seed.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "test": "vitest run",
    "test:race": "vitest run tests/race.test.ts",
    "test:api": "vitest run tests/api.test.ts",
    "test:chaos": "vitest run tests/chaos.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "dotenv": "^18.0.10",
    "fastify": "^5.0.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "autocannon": "^8.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
